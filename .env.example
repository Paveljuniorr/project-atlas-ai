# Project Atlas AI — Environment Variables
# Copy to .env.local and fill in values. NEVER commit secrets.

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string

# Google OAuth (primary auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-only)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_GENERATIVE_AI_API_KEY=

# Integration encryption (server-only)
INTEGRATION_ENCRYPTION_KEY=

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Twilio (optional WhatsApp/SMS provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email — Resend (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n (optional — customer instances use webhook URLs in app)
